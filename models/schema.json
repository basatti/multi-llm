{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1techhub.internal/llm-repo/models/schema.json",
  "title": "1TechHub LLM Platform model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "weights_uri", "revision", "serving"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.\\-]*$",
          "description": "Unique physical model id, referenced by gateway routes via model_info.manifest_id"
        },
        "family": {
          "type": "string",
          "description": "Upstream model family, e.g. qwen2.5, llama3.1"
        },
        "weights_uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]*/.+$",
          "description": "In-region S3 location nodes pull on boot"
        },
        "revision": {
          "type": "string",
          "minLength": 7,
          "description": "Immutable content revision (commit sha or checksum) of the weights"
        },
        "quantization": {
          "type": "string",
          "enum": ["none", "fp8", "awq", "gptq"],
          "default": "none"
        },
        "serving": { "$ref": "#/$defs/serving" },
        "adapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/adapter" }
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "instance_class", "replicas"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["vllm", "ollama"],
          "description": "vllm: one model pinned per container, max throughput. ollama: many models, hot-swap on demand, lower throughput. Use ollama on single-box GPU deploys serving multiple small models; vllm when one model needs all the GPU."
        },
        "instance_class": {
          "type": "string",
          "description": "AWS instance family/size, e.g. g5.xlarge, g6e.xlarge"
        },
        "max_model_len": {
          "type": "integer",
          "minimum": 1024
        },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "scale_to_zero"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 },
            "scale_to_zero": {
              "type": "boolean",
              "description": "Permitted only for low-traffic async-tier models (architecture.md §4.3)"
            }
          },
          "allOf": [
            {
              "if": { "properties": { "scale_to_zero": { "const": false } } },
              "then": { "properties": { "min": { "minimum": 1 } } }
            }
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.\\-]*$",
          "description": "Unique LoRA adapter id, also routable from the gateway via manifest_id"
        },
        "uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]*/.+$"
        },
        "revision": { "type": "string" }
      }
    }
  }
}
